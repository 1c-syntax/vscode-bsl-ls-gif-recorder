Перем Заголовок Экспорт;

// Конструктор: создаёт форматировщик отчёта с заданным заголовком.
//
// Параметры:
//  ЗаголовокОтчета - Строка - заголовок будущего отчёта
Процедура ПриСозданииОбъекта(ЗаголовокОтчета) Экспорт
	Заголовок = ЗаголовокОтчета;
КонецПроцедуры

// Возвращает сформированный отчёт.
//
// Возвращаемое значение:
//  Строка - текст отчёта
Функция Сформировать() Экспорт
	Возврат Заголовок;
КонецФункции

// Добавляет в отчёт строку показателя.
//
// Параметры:
//  Имя - Строка - название показателя
//  Значение - Число - значение показателя
Процедура ДобавитьПоказатель(Имя, Значение) Экспорт
	Заголовок = Заголовок + " | " + Имя + ": " + Значение;
КонецПроцедуры
