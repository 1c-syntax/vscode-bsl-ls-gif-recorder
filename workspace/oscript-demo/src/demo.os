#Использовать demolib

Процедура ВыполнитьДемо()

	// Переход к модулю OneScript
	СтроковыеУтилиты.ВыполнитьФорматирование("текст");

	// Класс с явным конструктором (ПриСозданииОбъекта)
	Отчет = Новый ФорматировщикОтчета("Итоги месяца");

	// Класс без конструктора
	Контейнер = Новый ПростойКонтейнер();

	// Метод экземпляра класса OneScript
	Результат = Отчет.Сформировать();

КонецПроцедуры
