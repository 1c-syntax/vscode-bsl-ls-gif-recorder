#Область ОписаниеМодуля

// Многострочный блочный комментарий, который
// language server сворачивает в отдельную
// сворачиваемую область целиком.
Процедура ОбработатьДокумент(Документ, Режим) Экспорт

	Если Режим = "Создание" Тогда
		Документ.Дата = ТекущаяДата();
		Документ.Автор = "Система";
	ИначеЕсли Режим = "Изменение" Тогда
		Документ.ДатаИзменения = ТекущаяДата();
		Документ.Изменил = "Система";
	Иначе
		ВызватьИсключение "Неизвестный режим обработки";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество
		|ПОМЕСТИТЬ ВременныеТовары
		|ИЗ
		|	Документ.РасходТовара.Товары КАК Товары
		|;
		|
		|ВЫБРАТЬ
		|	ВременныеТовары.Номенклатура КАК Номенклатура,
		|	СУММА(ВременныеТовары.Количество) КАК Количество
		|ИЗ
		|	ВременныеТовары КАК ВременныеТовары
		|СГРУППИРОВАТЬ ПО
		|	ВременныеТовары.Номенклатура";

	РезультатЗапроса = Запрос.Выполнить();

КонецПроцедуры

#КонецОбласти
