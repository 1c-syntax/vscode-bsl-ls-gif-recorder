Процедура РассчитатьСкидку(Клиент, Сумма) Экспорт
	Если Сумма > 1000 Тогда
		Скидка = 10;
	ИначеЕсли Сумма > 500 Тогда
		Скидка = 5;
	Иначе
		Скидка = 0;
	КонецЕсли;
	Для Каждого Заказ Из Клиент.Заказы Цикл
		Если Заказ.Оплачен Тогда
			Скидка = Скидка + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Скидка;
КонецПроцедуры
