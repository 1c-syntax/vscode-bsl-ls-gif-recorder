/v8bin/
# code-server extensions (installed from open-vsx by setup.sh)
/extensions/
*.tar.gz
*.jar

# --- code-server state: only the user settings are part of the stand ---
/config/*
!/config/User/
/config/User/*
!/config/User/settings.json

# --- SSL is a submodule (vendor/ssl_3_2) bind-mounted into the container at
#     /home/coder/project/src; Docker leaves an empty mount point here ---
/workspace/src/

